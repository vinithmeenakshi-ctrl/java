import java.util.Scanner;

public class FibonacciDoWhile {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n, a = 0, b = 1, count = 0;

        System.out.print("Enter number of terms: ");
        n = sc.nextInt();

        do {
            System.out.print(a + " ");
            int next = a + b;
            a = b;
            b = next;
            count++;
        } while (count < n);
    }
}
