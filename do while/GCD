import java.util.Scanner;

public class GCDDoWhile {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int a = sc.nextInt();
        int b = sc.nextInt();

        int temp;

        do {
            temp = b;
            b = a % b;
            a = temp;
        } while (b != 0);

        System.out.println("GCD = " + a);
    }
}
