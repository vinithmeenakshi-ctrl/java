class Main {

    static boolean isPalindrome(int num) {
        int original = num;
        int rev = 0;

        while (num != 0) {
            int digit = num % 10;
            rev = rev * 10 + digit;
            num /= 10;
        }
        return original == rev;
    }

    public static void main(String[] args) {
        System.out.println(isPalindrome(121));
    }
}
