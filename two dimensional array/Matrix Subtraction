public class MatrixSubtraction {

    public static void main(String[] args) {

        int[][] A={{8,7},{6,5}};
        int[][] B={{1,2},{3,4}};

        for(int i=0;i<2;i++){
            for(int j=0;j<2;j++){
                System.out.print((A[i][j]-B[i][j])+" ");
            }
            System.out.println();
        }
    }
}
